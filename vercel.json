{
  "buildCommand": "cd polyedge-paper && npm run build",
  "outputDirectory": "polyedge-paper/.next",
  "installCommand": "cd polyedge-paper && npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/resolve",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/research",
      "schedule": "0 8 * * *"
    }
  ]
}
