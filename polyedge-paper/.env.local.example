# Google Sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=polyedge@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_SHEET_ID=your-spreadsheet-id-from-url

# OpenAI (GPT-5.4 Nano)
OPENAI_API_KEY=sk-your-key

# Vercel Cron Secret (protect cron endpoints)
CRON_SECRET=your-random-secret-string

# Telegram Notifications (optional — also configurable from Settings UI)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-1001234567890

# Discord Notifications (optional — also configurable from Settings UI)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
